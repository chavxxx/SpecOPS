              "field": "packets"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "title": "Top Targeted Public IPs",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "opensearch",
        "uid": "WISPnet-OpenSearch"
      },
      "targets": [
        {
          "query": "traffic_direction:inbound",
          "metrics": [
            {
              "type": "count",
              "id": "1"
