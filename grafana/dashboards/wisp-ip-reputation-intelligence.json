        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "opensearch",
        "uid": "WISPnet-OpenSearch"
      },
      "targets": [
        {
          "query": "is_listed: true",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "2",
