  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Reputation Status Distribution",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "opensearch",
        "uid": "WISPnet-OpenSearch"
      },
      "targets": [
        {
          "query": "*",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "2",
              "field": "risk_status"
            }
          ]
        }
      ]
    },
    {
      "id": 2,
