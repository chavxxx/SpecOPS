# ==============================================================================
# WISP Network & Data Solutions (WISPnet) - Security Monitoring Configuration
# Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE PRODUCTION VALUES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=production
APP_SECRET_KEY=generate_a_random_32_character_secret_key_here
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. DETERMINISTIC CGNAT DEFAULTS
# ------------------------------------------------------------------------------
# Intended public CGNAT prefix and usable address pool
CGNAT_PUBLIC_PREFIX=157.119.69.128/25
CGNAT_PUBLIC_START=157.119.69.129
CGNAT_PUBLIC_END=157.119.69.254

# Intended subscriber CGNAT pool
CGNAT_SUBSCRIBER_PREFIX=100.91.0.0/22
CGNAT_SUBSCRIBER_START=100.91.0.2
CGNAT_SUBSCRIBER_END=100.91.3.255

# Deterministic port block configuration
# Default: 2,048 ports per subscriber, beginning at port 2048 (ratio 1:31 or 1:32)
CGNAT_PORT_BLOCK_SIZE=2048
CGNAT_FIRST_ELIGIBLE_PORT=2048
CGNAT_LAST_ELIGIBLE_PORT=65535

# ------------------------------------------------------------------------------
# 3. ROUTEROS V7 INTEGRATION (READ-ONLY)
# ------------------------------------------------------------------------------
# Core Router (CCR2116 - CGNAT Translator)
CORE_ROUTER_HOST=10.0.0.1
CORE_ROUTER_PORT=8728
CORE_ROUTER_USER=wisp-security
CORE_ROUTER_PASSWORD=ChangeToSecureRouterOS7Password!
CORE_ROUTER_USE_SSL=false

# PPPoE Access Concentrator (CCR2116 - Subscriber Sessions)
PPPOE_AC_HOST=10.0.0.2
PPPOE_AC_PORT=8728
PPPOE_AC_USER=wisp-security
PPPOE_AC_PASSWORD=ChangeToSecureRouterOS7Password!
PPPOE_AC_USE_SSL=false

# ------------------------------------------------------------------------------
# 4. OPENSEARCH SIEM & ANALYTICS
# ------------------------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=wisp
OPENSEARCH_BATCH_SIZE=200
OPENSEARCH_FLUSH_INTERVAL_SEC=5

# ------------------------------------------------------------------------------
# 5. SURICATA IDS/NSM SENSOR
# ------------------------------------------------------------------------------
SURICATA_EVE_PATH=/var/log/suricata/eve.json
SURICATA_PRE_NAT_INTERFACE=sfp-sfpplus1-pre
SURICATA_POST_NAT_INTERFACE=sfp-sfpplus2-post

# ------------------------------------------------------------------------------
# 6. AKVORADO FLOW ANALYTICS
# ------------------------------------------------------------------------------
AKVORADO_CLICKHOUSE_URL=http://localhost:8123
AKVORADO_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & SIEM ESCALATION
# ------------------------------------------------------------------------------
WEBHOOK_URL=https://alerts.wispnet.internal/webhook/security
WEBHOOK_SECRET=generate_webhook_hmac_secret
NOTIFICATION_COOLDOWN_MINUTES=15

# ------------------------------------------------------------------------------
# 8. GRAFANA DASHBOARDS & VISUALIZATION
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
